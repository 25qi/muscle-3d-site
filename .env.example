# AdSense。複製成 .env(不進版控),填好後重新 build 廣告才會出現。
# 全站下架廣告:把 VITE_ADS_ENABLED 改成 false 重新 deploy 即可,不用動程式碼。

VITE_ADS_ENABLED=false

# AdSense 後台 → 帳戶 → 設定 → 帳戶資訊
VITE_ADS_CLIENT=ca-pub-0000000000000000

# AdSense 後台 → 廣告 → 依廣告單元,各建一個「多媒體廣告」單元後取得的 data-ad-slot
# 沒填的版位不會渲染,可以只開其中一個
VITE_ADS_SLOT_FEED=0000000000
VITE_ADS_SLOT_PANEL_END=0000000000
